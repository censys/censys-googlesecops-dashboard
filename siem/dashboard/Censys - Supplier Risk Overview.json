            ],
            "dashboardQueries": [
                {
                    "name": "e0b0a84c-c2e7-4dd9-8242-1cab6f027293",
                    "query": "metadata.log_type = \"CENSYS_SUPPLIER_RISK_CUSTOM\"\r\n$status = security_result.detection_fields[\"status\"]\r\n$status = \"open\"\r\n$severity = if(security_result.severity = \"CRITICAL\", \"CRITICAL\", if(security_result.severity = \"HIGH\", \"HIGH\", if(security_result.severity = \"MEDIUM\", \"MEDIUM\", if(security_result.severity = \"LOW\", \"LOW\", if(security_result.severity = \"INFORMATIONAL\", \"INFORMATIONAL\", \"UNKNOWN\")))))\r\n$severity = /$severity$/ nocase\r\nsecurity_result.category_details = /$risk_category$/ nocase\r\nsecurity_result.associations.name = /$supplier$/ nocase\r\nmatch:\r\n  security_result.category_details\r\noutcome:\r\n  $risk_count = count_distinct(security_result.threat_id)\r\norder:\r\n  $risk_count desc",
                    "input": {
                        "relativeTime": {
                            "timeUnit": "DAY",
                            "startTimeVal": "1"
                        }
                    },
                    "etag": "c1b7383ebd573baee42263d4f1626c90e7056068b11f4cbe62896c9482f254cd",
                    "dialect": "YL2"
                },
                {
                    "name": "0db63d61-8bcf-44b5-8644-51aa143c7afd",
                    "query": "metadata.log_type = \"CENSYS_SUPPLIER_RISK_CUSTOM\"\r\nsecurity_result.detection_fields[\"rapid_response\"] = \"true\"\r\n$id = metadata.product_log_id\r\n$severity = if(security_result.severity = \"CRITICAL\", \"CRITICAL\", if(security_result.severity = \"HIGH\", \"HIGH\", if(security_result.severity = \"MEDIUM\", \"MEDIUM\", if(security_result.severity = \"LOW\", \"LOW\", if(security_result.severity = \"INFORMATIONAL\", \"INFORMATIONAL\", \"UNKNOWN\")))))\r\n$severity = /$severity$/ nocase\r\nsecurity_result.category_details = /$risk_category$/ nocase\r\nsecurity_result.detection_fields[\"status\"] = /$status$/ nocase\r\nsecurity_result.associations.name = /$supplier$/ nocase\r\nmatch:\r\n    $id\r\noutcome:\r\n    $time = array_distinct(timestamp.get_timestamp(metadata.collected_timestamp.seconds))\r\n    $risk_name = array_distinct(security_result.threat_name)\r\n    $severity_display = array_distinct($severity)\r\n    $supplier = array_distinct(security_result.associations.name)\r\n    $platform_url = array_distinct(metadata.url_back_to_product)\r\norder:\r\n    $time desc\r\nlimit:\r\n    1000",
                    "input": {
                        "relativeTime": {
                            "timeUnit": "DAY",
                            "startTimeVal": "1"

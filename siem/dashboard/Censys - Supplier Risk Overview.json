                            },
                            {
                                "id": "AAF66B4C-1F3F-4169-9AF1-5F33B99F8F7B",
                                "displayName": "Run search on risk name",
                                "customSettings": {
                                    "newTab": true,
                                    "leftClickColumn": "risk_name",
                                    "query": {
                                        "query": "metadata.log_type = \"CENSYS_SUPPLIER_RISK_CUSTOM\"\r\nsecurity_result.detection_fields[\"status\"] = \"open\"\r\nsecurity_result.threat_name = ${risk_name}",
